# Server
PORT=4000

# AI / LLM Provider Setting: 'auto' | 'gemini' | 'ollama' | 'anthropic'
# 'auto' automatically uses Gemini (if key set), or Ollama (if running), or Claude
LLM_PROVIDER=auto

# Option 1: Google Gemini API (Free tier with generous quota)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Option 2: Local Ollama (100% free & local, run: ollama run llama3.2)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 3: Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# External binaries (must be installed and on your PATH, or give absolute paths)
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Local Whisper transcription
# Requires: pip install -U openai-whisper
WHISPER_PATH=whisper
WHISPER_MODEL=base

# Clip settings
MIN_CLIP_SECONDS=25
MAX_CLIP_SECONDS=75
MAX_CLIPS_PER_VIDEO=6

# YouTube Data API v3 Upload (OAuth 2.0 Client Credentials)
# Get credentials at https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:4000/api/youtube/oauth2callback

# Auto-Pilot Channel Checking Interval (minutes)
CHANNEL_CHECK_INTERVAL_MINUTES=30
